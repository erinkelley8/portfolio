{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run sqlfluff:*)",
      "Bash(uv run pytest:*)",
      "Bash(duckdb:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
